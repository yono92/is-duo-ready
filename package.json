{
  "name": "duo-ready",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node --import tsx scripts/verify-production.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:status": "node --import tsx scripts/local-db.ts status",
    "db:env": "node --import tsx scripts/local-db.ts env",
    "db:check": "node --import tsx scripts/check-db.ts",
    "env:check": "node --import tsx scripts/check-env.ts",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:db": "node --import tsx scripts/test-db.ts",
    "test:admin": "node --import tsx scripts/test-db.ts --e2e",
    "admin:local": "node --import tsx scripts/local-admin.ts",
    "test:apple": "node --import tsx scripts/probe-app-store.ts",
    "test:production:db": "node --import tsx scripts/test-db.ts --production",
    "collect": "node --import tsx scripts/collect.ts",
    "icons:sync": "node --import tsx scripts/sync-icons.ts",
    "release:export": "node --import tsx scripts/export-content.ts",
    "release:setup": "node --import tsx scripts/hosted.ts",
    "release:transfer-data": "node --import tsx scripts/transfer-data.ts",
    "release:transfer-icons": "node --import tsx scripts/transfer-icons.ts",
    "release:check": "node --import tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.4",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@stylexjs/stylex": "0.19.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yono92/is-duo-ready.git"
  },
  "bugs": {
    "url": "https://github.com/yono92/is-duo-ready/issues"
  }
}
