# Local PostgreSQL only. Server-side credentials: never add NEXT_PUBLIC_ to this name.
# Use npm run db:start && npm run db:env. UI-only development needs no DB configuration.
DATABASE_URL=
# Hosted Supabase Production only. Do not set these for local PostgreSQL development.
# Hosted authentication uses verified Supabase users plus the private admin allow-list.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloud deployment guard: real production project reference (not a secret).
# Production must match this exact project ref; local development stays on PostgreSQL.
SUPABASE_PRODUCTION_PROJECT_REF=
# Set true only for local `next start` QA. Always blocked when VERCEL exists.
LOCAL_FIXTURES=false
# Public canonical origin; use your real domain only after setup. Local fallback is localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit mode: fixtures (default) or postgres. DB errors never fall back to fixtures.
DIRECTORY_DATA_SOURCE=fixtures
# Index only after real-content/rights/launch checks, and only on Vercel Production.
PUBLIC_INDEXING=false
# Opt-in local login: use npm run admin:local with an existing local DB and migrations.
# NODE_ENV=production and any VERCEL environment always block this authentication.
LOCAL_ADMIN_AUTH=false
LOCAL_ADMIN_USER_ID=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Persistent local icon files; defaults to .data/app-icons. Back up with PostgreSQL.
# Local filesystem storage is blocked on Vercel.
APP_ICON_STORAGE_DIR=
# Hosted only: private Supabase bucket; never prefix the secret with NEXT_PUBLIC_.
ICON_STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=app-icons
SUPABASE_SECRET_KEY=
